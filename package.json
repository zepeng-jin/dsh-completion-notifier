{
  "name": "dsh-completion-notifier",
  "version": "1.0.0",
  "description": "DSH (DeepSeek Harness) 任务完成系统通知与声音提醒插件，原生集成 DSH 设置面板 · macOS native completion notifications and sound alerts with Settings UI for DeepSeek Harness",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./titler": "./src/host/titler.js",
    "./titler/package.json": "./src/host/titler/package.json",
    "./titler/locale/*.json": "./src/host/titler/locale/*.json",
    "./titler/icon.svg": "./src/host/titler/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "icon.svg",
    "locale"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "alert",
    "macos",
    "settings-ui"
  ],
  "author": "zepengjin",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zepeng-jin/dsh-completion-notifier.git"
  },
  "homepage": "https://github.com/zepeng-jin/dsh-completion-notifier#readme",
  "bugs": {
    "url": "https://github.com/zepeng-jin/dsh-completion-notifier/issues"
  },
  "icon": "icon.svg"
}
