{
  "name": "dsh-completion-notifier",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) 原生任务完成通知与审批提醒插件 · Native macOS completion notifications and user approval alerts with Settings UI for DeepSeek Harness",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "icon.svg",
    "locale"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "alert",
    "macos",
    "settings-ui"
  ],
  "author": "zepengjin",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zepeng-jin/dsh-completion-notifier.git"
  },
  "homepage": "https://github.com/zepeng-jin/dsh-completion-notifier#readme",
  "bugs": {
    "url": "https://github.com/zepeng-jin/dsh-completion-notifier/issues"
  },
  "icon": "icon.svg"
}
